{
  "name": "wdio-ai-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "wdio run ./wdio.android.conf.ts",
    "test:smoke": "wdio run ./wdio.android.conf.ts --mochaOpts.grep @smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "appium": "appium --port 4723",
    "emulator": "bash scripts/start-emulator.sh",
    "test:unit": "tsx --test src/tcms/*.test.ts",
    "tcms:sync": "tsx src/tcms/suite-sync.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
